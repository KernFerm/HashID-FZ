[Unit]
Description=HashID FZ UART bridge
After=local-fs.target

[Service]
Type=simple
User=hashid-fz
Group=hashid-fz
ExecStart=/opt/hashid-fz/venv/bin/python /opt/hashid-fz/hashid_fz_bridge.py --port /dev/ttyUSB0 --baud 115200
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hashid-fz

[Install]
WantedBy=multi-user.target
